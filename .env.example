# Configuración pública de Firebase para esta app.
# Estas claves NO son secretas: Firebase las diseña para vivir en el
# bundle del cliente (son visibles en cualquier navegador que use la app).
# La seguridad real de los datos está en firestore.rules, no aquí.
#
# Copia este archivo a .env.local y completa los valores desde
# Firebase Console → Configuración del proyecto → Tus apps → SDK config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
